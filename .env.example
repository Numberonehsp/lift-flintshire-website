# Google Sheets Integration
# Sheet must be publicly readable (File > Share > Anyone with the link can view)
VITE_GOOGLE_SHEET_ID=your_google_sheet_id_here
VITE_GOOGLE_API_KEY=your_google_api_key_here

# --- Server-only (api/ functions, never exposed to the client) ---

# Private sheet: personal/health data, written server-side only.
# Share this sheet with the service account email below, not "anyone with the link".
PRIVATE_SHEET_ID=your_private_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","...":"paste full JSON key here"}

# Same values as VITE_GOOGLE_SHEET_ID / VITE_GOOGLE_API_KEY, without the VITE_ prefix,
# so api/ functions can read the public Ticket_Types tab without bundling secrets to the client.
GOOGLE_SHEET_ID_PUBLIC=your_google_sheet_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Resend transactional email
RESEND_API_KEY=your_resend_api_key_here

# Stripe (test keys in dev; see HANDOFF.md Event Ticketing section for go-live steps)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
SITE_URL=http://localhost:5173

# Brevo (email lists). Server-only: set in Vercel, never use a VITE_ prefix.
# New lists go in the Brevo folder named BREVO_FOLDER_NAME (default "Lift Flintshire website",
# matched ignoring case); the folder is created if it does not exist. Both folder settings are optional.
# BREVO_FOLDER_ID, if set to a number, overrides the name and uses that folder id directly.
BREVO_API_KEY=your_brevo_api_key_here
# BREVO_FOLDER_NAME=Lift Flintshire website
# BREVO_FOLDER_ID=
# Optional: newsletter double opt-in. Set to the numeric id of the Brevo double opt-in
# confirmation template to email a confirmation link before adding newsletter sign-ups.
# Leave unset to add them directly. Only the newsletter form uses it.
# BREVO_DOI_TEMPLATE_ID=
